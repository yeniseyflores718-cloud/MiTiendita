<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgTipoMovimiento"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/atras_circulo"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/mas"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtMontoMovimiento"
            app:layout_constraintStart_toEndOf="@id/imgTipoMovimiento"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtTituloMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Venta a crédito #0018"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hoy · 10:15"
                android:textColor="#8A8A8A"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMontoMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$330.00"
            android:textColor="#0F7B6C"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>