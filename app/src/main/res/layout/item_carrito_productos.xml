<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/imgProductoCarrito"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Imagen de producto"
            android:scaleType="centerInside"
            android:src="@drawable/catalogo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nombre del producto -->
        <TextView
            android:id="@+id/txtNombreProductoCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Arroz"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnMenos"
            app:layout_constraintStart_toEndOf="@+id/imgProductoCarrito"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Presentación o peso -->
        <TextView
            android:id="@+id/txtPresentacionCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Bolsa 1 kg"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/txtNombreProductoCarrito"
            app:layout_constraintStart_toEndOf="@+id/imgProductoCarrito"
            app:layout_constraintTop_toBottomOf="@+id/txtNombreProductoCarrito" />

        <!-- Precio -->
        <TextView
            android:id="@+id/txtPrecioCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="$32.00"
            android:textColor="#00796B"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgProductoCarrito"
            app:layout_constraintTop_toBottomOf="@+id/txtPresentacionCarrito" />

        <!-- Botón Menos (-) -->
        <Button
            android:id="@+id/btnMenos"
            android:layout_width="49dp"
            android:layout_height="54dp"
            android:backgroundTint="#F5F5F5"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="#212121"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtCantidadItem"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Cantidad -->
        <TextView
            android:id="@+id/txtCantidadItem"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="1"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnMas"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botón Más (+) -->
        <Button
            android:id="@+id/btnMas"
            android:layout_width="52dp"
            android:layout_height="54dp"
            android:backgroundTint="#F5F5F5"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="#212121"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>