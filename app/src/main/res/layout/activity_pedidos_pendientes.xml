<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8">

    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#087F78"
        android:gravity="center_vertical"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedidos pendientes"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pestanas"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        app:layout_constraintTop_toBottomOf="@id/encabezado">

        <TextView
            android:id="@+id/tvPendientes"
            android:layout_width="75dp"
            android:layout_height="32dp"
            android:background="#DCEFFA"
            android:gravity="center"
            android:text="Pendientes"
            android:textColor="#1685E5"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvListos"
            android:layout_width="55dp"
            android:layout_height="32dp"
            android:layout_marginLeft="7dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="Listos"
            android:textColor="#263238"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvEntregados"
            android:layout_width="75dp"
            android:layout_height="32dp"
            android:layout_marginLeft="7dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="Entregados"
            android:textColor="#263238"
            android:textSize="11sp"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/pestanas"
        app:layout_constraintBottom_toTopOf="@id/navegacion"/>

    <LinearLayout
        android:id="@+id/navegacion"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌗\nMenú"
            android:textColor="#89949B"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navInventario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⬡\nInventario"
            android:textColor="#89949B"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navVenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤\nVenta"
            android:textColor="#89949B"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/navPedidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nPedidos"
            android:textColor="#1685E5"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>