<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Número y estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtNumeroPedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pedido #0042"
            android:textColor="#263238"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtEstadoPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DDF3E9"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Pendiente"
            android:textColor="#16865B"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Cliente y total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtClientePedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del cliente"
            android:textColor="#263238"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txtTotalPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$133.00"
            android:textColor="#006D65"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Detalles -->
    <TextView
        android:id="@+id/txtDetallesPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="3 productos · Efectivo al recoger · 10:15"
        android:textColor="#89949B"
        android:textSize="10sp"/>

</LinearLayout>